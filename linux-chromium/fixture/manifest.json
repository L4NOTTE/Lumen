{
  "manifest_version": 3,
  "name": "Lumen compatibility probe",
  "version": "1.0",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "tabCapture",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}